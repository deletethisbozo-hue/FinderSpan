<UserControl
    x:Class="Span.Views.HomeModeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Span.Models"
    xmlns:helpers="using:Span.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="FinderHomeListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#FFFFFF">
        <StackPanel x:Name="RootPanel" Padding="28,22,34,32" Spacing="18">
            <StackPanel Spacing="7">
                <TextBlock x:Name="DevicesHeader" Text="Devices and drives" FontSize="11" FontWeight="SemiBold" Foreground="#777777" Margin="6,0,0,0"/>
                <Border Background="#FBFBFB" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="9">
                    <ListView x:Name="DrivesGridView" ItemsSource="{x:Bind LocalDrives, Mode=OneWay}" IsItemClickEnabled="True"
                              ItemClick="OnDriveItemClick" SelectionMode="None" ItemContainerStyle="{StaticResource FinderHomeListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DriveItem">
                                <Grid MinHeight="50" Padding="12,6" RightTapped="OnDriveRightTapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" FontFamily="{StaticResource RemixIcons}" Glyph="{x:Bind IconGlyph}" FontSize="21"
                                              Foreground="{ThemeResource SpanAccentBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind SizeDescription}" FontSize="10" Foreground="#8A8A8A" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ProgressBar Grid.Column="2" Value="{x:Bind UsagePercent}" Maximum="100" Height="4" CornerRadius="2"
                                                 VerticalAlignment="Center" Margin="14,0,12,0"/>
                                    <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="10" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <StackPanel x:Name="CloudSection" Spacing="7" Visibility="{x:Bind HasCloudDrives}">
                <TextBlock x:Name="CloudHeader" Text="Cloud storage" FontSize="11" FontWeight="SemiBold" Foreground="#777777" Margin="6,0,0,0"/>
                <Border Background="#FBFBFB" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="9">
                    <ListView x:Name="CloudDrivesGridView" ItemsSource="{x:Bind CloudDrivesList, Mode=OneWay}" IsItemClickEnabled="True"
                              ItemClick="OnDriveItemClick" SelectionMode="None" ItemContainerStyle="{StaticResource FinderHomeListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DriveItem">
                                <Grid MinHeight="46" Padding="12,5" RightTapped="OnDriveRightTapped">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" FontFamily="{StaticResource RemixIcons}" Glyph="{x:Bind IconGlyph}" FontSize="20"
                                              Foreground="{ThemeResource SpanAccentBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind SizeDescription}" FontSize="10" Foreground="#8A8A8A" TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind helpers:VisibilityHelper.FromNonEmpty(SizeDescription)}"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <StackPanel x:Name="NetworkSection" Spacing="7" Visibility="{x:Bind HasNetworkDrives}">
                <TextBlock x:Name="NetworkHeader" Text="Network locations" FontSize="11" FontWeight="SemiBold" Foreground="#777777" Margin="6,0,0,0"/>
                <Border Background="#FBFBFB" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="9">
                    <ListView x:Name="NetworkDrivesGridView" ItemsSource="{x:Bind NetworkDrivesList, Mode=OneWay}" IsItemClickEnabled="True"
                              ItemClick="OnDriveItemClick" SelectionMode="None" ItemContainerStyle="{StaticResource FinderHomeListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DriveItem">
                                <Grid MinHeight="46" Padding="12,5" RightTapped="OnDriveRightTapped">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" FontFamily="{StaticResource RemixIcons}" Glyph="{x:Bind IconGlyph}" FontSize="20" Foreground="#6E6E6E" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind SizeDescription}" FontSize="10" Foreground="#8A8A8A" TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind helpers:VisibilityHelper.FromNonEmpty(SizeDescription)}"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <StackPanel Spacing="7">
                <TextBlock x:Name="FavoritesHeader" Text="Favorites" FontSize="11" FontWeight="SemiBold" Foreground="#777777" Margin="6,0,0,0"/>
                <Border Background="#FBFBFB" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="9">
                    <ListView x:Name="FavoritesGridView" ItemsSource="{x:Bind Favorites, Mode=OneWay}" IsItemClickEnabled="True"
                              ItemClick="OnFavoriteItemClick" ContainerContentChanging="OnFavoriteContainerContentChanging" SelectionMode="None"
                              ItemContainerStyle="{StaticResource FinderHomeListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FavoriteItem">
                                <Grid MinHeight="44" Padding="12,4" RightTapped="OnFavoriteRightTapped">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Image Source="{x:Bind CustomIcon, Mode=OneWay}" Visibility="{x:Bind CustomIconVisibility, Mode=OneWay}" Width="20" Height="20"/>
                                        <FontIcon FontFamily="{StaticResource RemixIcons}" Glyph="{x:Bind IconGlyph}" Foreground="{x:Bind IconBrush}"
                                                  FontSize="19" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"/>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
